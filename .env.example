# TenantEase Property Intelligence Environment Configuration

# Database Configuration (SQLite default for local prototype; PostgreSQL compatible)
DATABASE_URL=sqlite:///./data/tenantease.db

# Optional LLM Configuration (Application works 100% deterministically without this)
# Set to 'mock', 'openai', or leave empty for deterministic baseline
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SEED=42
